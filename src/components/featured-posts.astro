<section id="featured" class="scroll-mt-20 border-t border-rule bg-paper-raised">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-serif text-3xl tracking-tight text-ink sm:text-4xl">Featured this week</h2>
        <p class="mt-2 text-ink-muted">Picked by editors, not by an algorithm.</p>
      </div>
      <a
        href="/featured"
        class="text-sm font-medium text-brand no-underline transition-colors hover:text-brand-strong"
      >
        Browse the archive &rarr;
      </a>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <a
        href={lead.href}
        class="group flex flex-col justify-between rounded-2xl border border-rule bg-paper p-7 no-underline transition-colors hover:border-brand/40 hover:bg-brand-tint/40"
      >
        <div>
          <span class="text-xs font-semibold tracking-widest text-brand uppercase">{lead.topic}</span>
