              class="group flex h-full flex-col justify-between rounded-2xl border border-rule bg-paper p-6 no-underline transition-colors hover:border-brand/40 hover:bg-brand-tint/40"
            >
              <div>
                <span class="text-xs font-semibold tracking-widest text-brand uppercase">{post.topic}</span>
                <h3 class="mt-2 font-serif text-xl leading-snug text-ink transition-colors group-hover:text-brand-strong">
                  {post.title}
                </h3>
                <p class="mt-2 text-sm text-ink-muted">{post.excerpt}</p>
              </div>
              <p class="mt-4 text-sm text-ink-muted">
