    author: 'Jonah Keel',
    date: 'Aug 28, 2026',
    readingTime: '6 min',
  },
  {
    href: '/blog/markdown-is-enough',
    topic: 'Tooling',
    title: 'Markdown is enough',
    excerpt: 'A short defence of plain text against every editor that wants to be a word processor.',
    author: 'Adaeze Okonkwo',
    date: 'Aug 21, 2026',
    readingTime: '4 min',
  },
  {
    href: '/blog/one-hundred-true-readers',
    topic: 'Audience',
    title: 'One hundred true readers',
