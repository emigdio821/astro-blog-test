---
import SiteNav from '@/components/site-nav'

const pathname = Astro.url.pathname
---

<header class="sticky top-0 z-10 border-b border-rule/70 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-5">
    <a href="/" class="flex shrink-0 items-center gap-2 text-ink no-underline" aria-label="Inkwell home">
      <span
        class="flex size-8 items-center justify-center rounded-lg bg-brand font-serif text-lg leading-none text-white"
        aria-hidden="true"
      >
        I
      </span>
      <span class="font-serif text-xl tracking-tight">Inkwell</span>
    </a>

    <!-- Base UI is React-only, so the menu is the one hydrated island here. -->
    <SiteNav pathname={pathname} client:load />

    <a
      href="/signup"
      class="hidden h-9 shrink-0 items-center rounded-lg bg-brand px-4 text-sm font-medium text-white no-underline transition-colors hover:bg-brand-strong lg:flex"
    >
      Start writing
    </a>
  </div>
</header>
